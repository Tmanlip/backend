APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

MONGO_URI=
MONGODB_URI=
MONGODB_DATABASE=

OLLAMA_BASE_URL=http://127.0.0.1:11434
DOCUMENT_TEMPLATE_BASE_PATH=storage/app/document-generator/templates
DOCUMENT_GENERATOR_MODEL=llama3
CHATBOT_CLASSIFIER_ENABLED=true
CHATBOT_CLASSIFIER_BYPASS_ON_CRIMINAL_KEYWORDS=true
CHATBOT_CRIMINAL_KEYWORD_OVERRIDE=true
CHATBOT_CIVIL_KEYWORD_OVERRIDE=true
CHATBOT_CORPORATE_KEYWORD_OVERRIDE=true
CHATBOT_UNLIMITED_NUM_PREDICT=true
CHATBOT_DEFAULT_NUM_PREDICT=-1
CHATBOT_CIVIL_NUM_PREDICT=
CHATBOT_CORPORATE_NUM_PREDICT=
CHATBOT_CRIMINAL_NUM_PREDICT=
CHATBOT_GENERAL_NUM_PREDICT=
CHATBOT_CLASSIFIER_TIMEOUT_MS=12000
CHATBOT_GENERATION_TIMEOUT_MS=60000
CHATBOT_PLAYBOOK_PATH=storage/app/chatbot/operations-playbook-excel

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_DRIVER=file
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

AZURE_STORAGE_NAME=
AZURE_STORAGE_CONTAINER=
AZURE_STORAGE_KEY=
AZURE_CLIENT_ID=

GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_CREDENTIALS_JSON=
GOOGLE_CALENDAR_DELEGATED_USER=

SANCTUM_STATEFUL_DOMAINS=
# Token expiration values are in minutes.
# - Session (Remember Me unchecked): 1440 = 1 day
# - Remember Me checked: 43200 = 30 days
# Example:
# SANCTUM_SESSION_EXPIRATION=1440
# SANCTUM_REMEMBER_ME_EXPIRATION=43200
SANCTUM_SESSION_EXPIRATION=
SANCTUM_REMEMBER_ME_EXPIRATION=
SESSION_DOMAIN=
